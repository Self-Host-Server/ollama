# Copy to .env and fill in the real values. .env is gitignored -- never commit it.

# --- Open WebUI base URL ------------------------------------------------
# Used by Open WebUI to build its own OAuth redirect URI
# (<WEBUI_URL>/oauth/oidc/callback). Must match what's registered as the
# redirect URI in the Authentik Application for Open WebUI, exactly
# (Authentik redirect-URI matching is strict).
WEBUI_URL=http://192.168.1.44:3000

# --- Authentik SSO (OIDC) ------------------------------------------------
ENABLE_OAUTH_SIGNUP=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
OAUTH_PROVIDER_NAME=Authentik

# The OIDC discovery URL from the Authentik OAuth2 Provider for Open WebUI,
# e.g. https://authentik.example.com/application/o/open-webui/.well-known/openid-configuration
OPENID_PROVIDER_URL=

# Client ID/Secret from the Authentik OAuth2 Provider + Application
# registration for Open WebUI.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

OAUTH_SCOPES=openid email profile
